<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- M4：提醒通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      精确闹钟，两条一起声明：

      SCHEDULE_EXACT_ALARM 是「可被用户撤销」的权限，Android 14 起新装应用默认拒绝，
      未授权时调度器只能退化成 setAndAllowWhileIdle，表现就是「提前 10 分钟」的提醒
      实际晚了 4~5 分钟才响（真机已复现）。

      USE_EXACT_ALARM 是 API 33 引入的普通权限，安装即授予、不受用户开关影响，
      专供闹钟与日历这类「提醒必须准点」类应用。minSdk 已对齐 33，因此现代系统上
      走这一条即可，SCHEDULE_EXACT_ALARM 只作为旧行为兜底保留。

      注意：Google Play 对 USE_EXACT_ALARM 有用途审查（仅限闹钟/日历类核心功能），
      M7 上架前需在商店后台声明用途；若审核不通过，则回退为仅 SCHEDULE_EXACT_ALARM
      并依赖诊断页的引导开关。
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 关机重启后重建闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".YingApp"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:theme="@style/Theme.Ying">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 长按图标弹出的「添加小部件」：静态快捷方式必须挂在有 LAUNCHER 的 activity 上 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 闹钟触发 / 通知按钮动作。exported=false：只接受本应用 PendingIntent 的投递 -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- 关机重启与时间变更后重建排期。系统广播对 exported=false 的接收器仍可投递 -->
        <receiver
            android:name=".reminder.ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- ============ M5 桌面小部件 ============ -->

        <!-- 总览小部件。exported=true 是硬要求：APPWIDGET_UPDATE 由系统进程投递 -->
        <receiver
            android:name=".widget.YingWidgetProvider"
            android:exported="true"
            android:label="@string/widget_overview_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_overview_info" />
        </receiver>

        <!-- 单事件小部件 -->
        <receiver
            android:name=".widget.YingDetailWidgetProvider"
            android:exported="true"
            android:label="@string/widget_detail_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_detail_info" />
        </receiver>

        <!--
          配置台：由 appwidget-provider 的 android:configure 显式指向，
          因此**不要**加 APPWIDGET_CONFIGURE 的 intent-filter，
          否则两个配置页会同时响应，启动器可能弹出二选一。
        -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Ying" />

        <activity
            android:name=".widget.DetailWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Ying" />

        <!--
          长按图标 / 设置页里的「添加小部件」。不渲染界面，交给系统弹确认框。
          exported=true：静态快捷方式的 intent 由桌面进程投递，必须可从外部启动；
          它只做 requestPinAppWidget，没有可被滥用的副作用。
        -->
        <activity
            android:name=".widget.WidgetPinActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- 跨天刷新闹钟。exported=false：只接受本应用 PendingIntent 的投递 -->
        <receiver
            android:name=".widget.WidgetMidnightReceiver"
            android:exported="false" />
    </application>

</manifest>
