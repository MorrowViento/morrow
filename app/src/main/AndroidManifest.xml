<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- M4：提醒通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 精确闹钟：Android 14 起新装应用默认拒绝，需在提醒诊断页引导用户开启，
         未开启时调度器退化为不精确闹钟（仍会提醒，但可能延后几分钟） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 关机重启后重建闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".YingApp"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:theme="@style/Theme.Ying">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 闹钟触发 / 通知按钮动作。exported=false：只接受本应用 PendingIntent 的投递 -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- 关机重启与时间变更后重建排期。系统广播对 exported=false 的接收器仍可投递 -->
        <receiver
            android:name=".reminder.ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- ============ M5 桌面小部件 ============ -->

        <!-- 总览小部件。exported=true 是硬要求：APPWIDGET_UPDATE 由系统进程投递 -->
        <receiver
            android:name=".widget.YingWidgetProvider"
            android:exported="true"
            android:label="@string/widget_overview_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_overview_info" />
        </receiver>

        <!-- 单事件小部件 -->
        <receiver
            android:name=".widget.YingDetailWidgetProvider"
            android:exported="true"
            android:label="@string/widget_detail_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_detail_info" />
        </receiver>

        <!--
          配置台：由 appwidget-provider 的 android:configure 显式指向，
          因此**不要**加 APPWIDGET_CONFIGURE 的 intent-filter，
          否则两个配置页会同时响应，启动器可能弹出二选一。
        -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Ying" />

        <activity
            android:name=".widget.DetailWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Ying" />

        <!-- 跨天刷新闹钟。exported=false：只接受本应用 PendingIntent 的投递 -->
        <receiver
            android:name=".widget.WidgetMidnightReceiver"
            android:exported="false" />
    </application>

</manifest>
