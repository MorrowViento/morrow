<?xml version="1.0" encoding="utf-8"?><!--
  总览小部件。

  为什么是 5 组写死的行而不是一个列表：RemoteViews 只能直连静态视图，
  集合视图必须走 RemoteViewsService + Adapter，为一个 1~5 行的小部件引入整套
  Service 生命周期不划算。多出来的行在刷新时直接 GONE。

  颜色、字号、显隐全部由 WidgetRefresher 在运行时套用，这里只放中性占位值。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            style="@style/WidgetText"
            android:id="@+id/widget_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_header_title"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            style="@style/WidgetText.Dim"
            android:id="@+id/widget_header_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_loading"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 空态：没有事件时顶掉所有行 -->
    <TextView
        style="@style/WidgetText.Dim"
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/widget_empty"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetText"
                android:id="@+id/row0_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="15sp" />

            <TextView
                style="@style/WidgetText.Dim"
                android:id="@+id/row0_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/row0_progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetText"
                android:id="@+id/row0_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                style="@style/WidgetText.Dim"
                android:id="@+id/row0_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
