<?xml version="1.0" encoding="utf-8"?><!--
  Android 13 主题图标（Monochrome）用的单色版本。

  系统只取 alpha 通道再着色，因此这里一律纯白、不保留灰阶：
  与前景同一套「圆相 + 半日半月」几何，描边宽度与前景一致，
  否则主题化之后环会突然变细、和壁纸上的彩色版本对不上。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M74.97,40.38 A25,25 0 1 1 67.62,33.03"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,41.5 A12.5,12.5 0 0 0 54,66.5 Z"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M54,41.5 A12.5,12.5 0 0 1 54,66.5"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
</vector>
