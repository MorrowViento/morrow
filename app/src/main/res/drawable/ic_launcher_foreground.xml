<?xml version="1.0" encoding="utf-8"?><!--
  「朝夕」自适应图标前景：半日半月。

  一侧是实心暖金半圆（朝），另一侧只留等宽圆弧（夕），中间一刀分开 ——
  比「日轮 + 八道光芒 + 倒影」少了很多装饰，缩小到启动器尺寸也不会糊成一团。
  全部纯色、无渐变；两块形状共用同一个圆心与半径，接缝严丝合缝。
  构图半径 25dp + 描边 3dp，最远点距中心 28dp，圆形 / 方圆 / 水滴遮罩都切不到。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 左半：实心（朝） -->
    <path
        android:pathData="M54,29 A25,25 0 0 0 54,79 Z"
        android:fillColor="#F3C56C" />
    <!-- 右半：只描边（夕） -->
    <path
        android:pathData="M54,29 A25,25 0 0 1 54,79"
        android:fillColor="#00000000"
        android:strokeColor="#F3C56C"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
</vector>
