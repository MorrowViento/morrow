<?xml version="1.0" encoding="utf-8"?>
<!--
  「朝夕」自适应图标前景：一轮日轮 + 地平线 + 水面倒影。
  构图控制在中心 66dp 安全圆内（最远点距中心约 29dp），
  圆形 / 方圆 / 水滴等厂商遮罩都不会切到主体。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 日轮 -->
    <path
        android:pathData="M54,46m-15,0a15,15 0,1 1,30 0a15,15 0,1 1,-30 0"
        android:fillColor="#FFF8EA" />
    <!-- 地平线：向上一拱，日轮恰好落在弧顶 -->
    <path
        android:pathData="M30,70 Q54,54 78,70"
        android:fillColor="#00000000"
        android:strokeColor="#FFF8EA"
        android:strokeWidth="3.6"
        android:strokeLineCap="round" />
    <!-- 倒影：更短、更淡的一条弧 -->
    <path
        android:pathData="M38,79 Q54,72 70,79"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.55"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
</vector>
