<?xml version="1.0" encoding="utf-8"?><!--
  行卡片底：不再是纯白实心。

  纯白在浅色壁纸/暖色背景上像一张贴上去的纸，和整块玻璃底板脱节。
  这里改成「白色 + 纵向 alpha 渐变」：顶部略实、底部略透，配合刷新时的
  colorFilter 着成当前配色，观感接近磨砂玻璃而不是纸片。
  注意 shape 的 alpha 会与 setColorFilter 的 alpha 相乘（SRC_ATOP），
  所以这里是相对系数，真正的浓度上限由 WidgetAppearance.rowTint 决定。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:angle="270"
        android:endColor="#BFFFFFFF"
        android:startColor="#E6FFFFFF"
        android:type="linear" />
</shape>
