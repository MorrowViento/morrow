<?xml version="1.0" encoding="utf-8"?><!--
  长按「萤」图标弹出的静态快捷方式。

  为什么要有它：Android 没有「应用自定义长按小部件菜单」的接口，「长按小部件 → 编辑」
  由桌面决定给不给（ColorOS 一类只给「移除 / 应用信息」）。但「长按应用图标」的菜单
  是标准能力：静态 shortcut 一定会出现在那里。

  点一条 = 走 `AppWidgetManager.requestPinAppWidget`，由系统弹出「添加到主屏幕」确认框，
  确认后直接落在桌面上——比「长按空白 → 小部件 → 找到萤 → 拖到桌面」少三步。
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:shortcutDisabledMessage="@string/shortcut_widget_disabled"
        android:shortcutId="widget_overview"
        android:shortcutLongLabel="@string/shortcut_widget_overview_long"
        android:shortcutShortLabel="@string/shortcut_widget_overview_short">
        <intent
            android:action="com.jiuxina.ying.action.PIN_OVERVIEW_WIDGET"
            android:targetClass="com.jiuxina.ying.widget.WidgetPinActivity"
            android:targetPackage="com.jiuxina.ying" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:shortcutDisabledMessage="@string/shortcut_widget_disabled"
        android:shortcutId="widget_detail"
        android:shortcutLongLabel="@string/shortcut_widget_detail_long"
        android:shortcutShortLabel="@string/shortcut_widget_detail_short">
        <intent
            android:action="com.jiuxina.ying.action.PIN_DETAIL_WIDGET"
            android:targetClass="com.jiuxina.ying.widget.WidgetPinActivity"
            android:targetPackage="com.jiuxina.ying" />
    </shortcut>
</shortcuts>
